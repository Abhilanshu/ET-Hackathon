# ── MentorAI Environment Variables ──────────────────────────────
# Copy this to .env and fill in values

# MongoDB Atlas connection string (optional — app works without it in offline mode)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mentorai_db

# JWT Secret — set any long random string
JWT_SECRET=your_jwt_secret_here

# Node environment
NODE_ENV=production
